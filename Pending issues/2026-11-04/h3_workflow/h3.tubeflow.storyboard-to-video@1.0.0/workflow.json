{
  "video_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "text_encoder": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "diffusion": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "sage": {
    "class_type": "PathchSageAttentionKJ",
    "inputs": {
      "model": [
        "diffusion",
        0
      ],
      "sage_attention": "auto",
      "allow_compile": false
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "condition": {
    "class_type": "MiniMaxH3AudioConditioningT8",
    "_meta": {
      "title": "TubeFlow AI - Test storyboard group video"
    },
    "inputs": {
      "clip": [
        "text_encoder",
        0
      ],
      "video_vae": [
        "video_vae",
        0
      ],
      "audio_vae": [
        "audio_vae",
        0
      ],
      "prompt": "",
      "width": 1056,
      "height": 608,
      "length": 124,
      "task_type": "Ref2VA",
      "audio_mode": "native",
      "audio_denoise_strength": 1,
      "add_source_as_reference": false,
      "prompt_primary_audio_ordinal": 0,
      "strict_prompt_tags": true,
      "ref_image_size": "match",
      "reference_video_policy": "official_2_to_15s"
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "dual_clock",
        0
      ],
      "conditioning": [
        "condition",
        0
      ]
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "dual_clock",
        1
      ],
      "sigmas": [
        "dual_clock",
        2
      ],
      "latent_image": [
        "condition",
        1
      ]
    }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "decode_av",
        0
      ],
      "audio": [
        "decode_av",
        1
      ],
      "fps": 24,
      "bit_depth": 8,
      "color_space": "sRGB"
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "create_video",
        0
      ],
      "filename_prefix": "tubeflow-test/pending",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 19
    }
  },
  "dual_clock": {
    "class_type": "MiniMaxH3DualClockSamplerT8",
    "inputs": {
      "model": [
        "sage",
        0
      ],
      "av_latent": [
        "condition",
        1
      ],
      "steps": 8,
      "shift_video": 12,
      "shift_audio": 3
    }
  },
  "decode_av": {
    "class_type": "MiniMaxH3AVDecodeT8",
    "inputs": {
      "av_latent": [
        "sample",
        0
      ],
      "video_vae": [
        "video_vae",
        0
      ],
      "audio_vae": [
        "audio_vae",
        0
      ]
    }
  }
