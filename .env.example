WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8000
PUBLIC_VOICE_CATALOG_ARCHIVE=./runtime/public-voice-catalog/public_voice_library.zip
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=tubeflow
MINIO_ROOT_PASSWORD=change-me-now
TUBEFLOW_DATABASE_URL=postgresql+psycopg://tubeflow:change-me@postgres/tubeflow
TUBEFLOW_ALLOWED_ORIGINS=["http://localhost:3000","http://192.168.1.10:3000"]
TUBEFLOW_COOKIE_SECURE=false
TUBEFLOW_MINIO_ENDPOINT=minio:9000
TUBEFLOW_IDENTITY_SETUP_USERNAME=
TUBEFLOW_IDENTITY_SETUP_PASSWORD=
TUBEFLOW_MINIO_ACCESS_KEY=tubeflow
TUBEFLOW_MINIO_SECRET_KEY=change-me-now
TUBEFLOW_MINIO_BUCKET=tubeflow-private
TUBEFLOW_TEMPORAL_TARGET=temporal:7233
TUBEFLOW_COSYVOICE_URL=http://cosyvoice:8000
TUBEFLOW_COSYVOICE_TOKEN=
TUBEFLOW_COSYVOICE_MAX_CONCURRENCY=4
TUBEFLOW_DIRECTOR_PROVIDER_URL=https://grsai.dakka.com.cn/v1
TUBEFLOW_DIRECTOR_PROVIDER_TOKEN=
TUBEFLOW_DIRECTOR_PROVIDER_MODEL=gpt-5.6-sol
TUBEFLOW_DIRECTOR_PROVIDER_TIMEOUT_SECONDS=900
# H3 组级视频提示词 LLM 编译器（KineStack v6 底本移植；未配置 token 时视频意图创建会显式失败）
TUBEFLOW_VIDEO_PROMPT_PROVIDER_URL=https://api.deepseek.com/v1
TUBEFLOW_VIDEO_PROMPT_PROVIDER_TOKEN=
TUBEFLOW_VIDEO_PROMPT_PROVIDER_MODEL=deepseek-v4-flash
TUBEFLOW_VIDEO_PROMPT_PROVIDER_TIMEOUT_SECONDS=45
# 编译模板版本：kinestack_v6_port（对照组）或 tubeflow_enhanced_v1（增强版）
TUBEFLOW_VIDEO_PROMPT_STRATEGY=tubeflow_storyboard_v4_natural_motion
# 单格参考 opt-in：默认关闭；启用时必须同时提供显式项目 allowlist，不设全局默认。
TUBEFLOW_H3_SINGLE_PANEL_OPT_IN_ENABLED=false
TUBEFLOW_H3_SINGLE_PANEL_PROJECT_IDS=[]
# §46: new projects (no storyboard yet) use grid v2 + one cropped panel per shot as H3 references.
TUBEFLOW_STORYBOARD_SINGLE_PANEL_NEW_PROJECTS=false
# Storyboard grid-sheet image provider. kind: "contract" (self-hosted /grid-sheets) or "grsai".
TUBEFLOW_STORYBOARD_PROVIDER_KIND=grsai
TUBEFLOW_STORYBOARD_PROVIDER_URL=https://grsai.dakka.com.cn
TUBEFLOW_STORYBOARD_PROVIDER_TOKEN=
TUBEFLOW_STORYBOARD_PROVIDER_MODEL=gpt-image-2.5
TUBEFLOW_STORYBOARD_PROVIDER_TIMEOUT_SECONDS=120
TUBEFLOW_STORYBOARD_PROVIDER_QUALITY=high
# Pix studio 故事板备用渠道（只写部署机私有 .env；不得提交真实 token）
TUBEFLOW_STORYBOARD_PIX_PROVIDER_URL=https://api.lk888.ai
TUBEFLOW_STORYBOARD_PIX_PROVIDER_TOKEN=
TUBEFLOW_STORYBOARD_PIX_PROVIDER_TIMEOUT_SECONDS=120
# Disabled by default. Configure all three lists together when actual nodes are supplied.
TUBEFLOW_H3_NODE_URLS=[]
TUBEFLOW_H3_NODE_IDS=[]
TUBEFLOW_H3_NODE_INSTANCE_IDS=[]
TUBEFLOW_H3_NODE_TOKENS=[]
TUBEFLOW_H3_NODE_CAPACITIES=[]
TUBEFLOW_H3_MODEL_KEY=minimax-h3-community
TUBEFLOW_H3_MODEL_VERSION=2026-08-13-community-duration-v1
TUBEFLOW_H3_WORKFLOW_ID=h3.community.reference-images-to-video
TUBEFLOW_H3_WORKFLOW_VERSION=1.1.0-mvp
# Required raw-byte SHA-256 when H3 nodes are enabled; never use a canonical JSON SHA.
TUBEFLOW_H3_WORKFLOW_MANIFEST_SHA256=
# 封面图生成：参考图视觉解析 Provider（OpenAI 兼容 chat/completions；token 留空即未启用，密钥只写 .env 不入库）
TUBEFLOW_COVER_ANALYSIS_PROVIDER_URL=https://grsai.dakka.com.cn/v1
TUBEFLOW_COVER_ANALYSIS_PROVIDER_TOKEN=
TUBEFLOW_COVER_ANALYSIS_PROVIDER_MODEL=gpt-5.5
TUBEFLOW_COVER_ANALYSIS_PROVIDER_FALLBACK_MODEL=gemini-3.1-pro
TUBEFLOW_COVER_ANALYSIS_PROVIDER_TIMEOUT_SECONDS=120
# 封面图生成：封面文字/画面提示词/评委文本 Provider（DeepSeek 端点，四处复用）
TUBEFLOW_COVER_PROMPT_PROVIDER_URL=https://api.deepseek.com/v1
TUBEFLOW_COVER_PROMPT_PROVIDER_TOKEN=
TUBEFLOW_COVER_PROMPT_PROVIDER_MODEL=deepseek-v4-flash
TUBEFLOW_COVER_PROMPT_PROVIDER_FALLBACK_MODEL=deepseek-v4-pro
TUBEFLOW_COVER_PROMPT_PROVIDER_TIMEOUT_SECONDS=300
# 封面图生成：出图 Provider（images/generations，同步请求-响应）
TUBEFLOW_COVER_IMAGE_PROVIDER_URL=https://api.lingkeai.ai/v1
TUBEFLOW_COVER_IMAGE_PROVIDER_TOKEN=
TUBEFLOW_COVER_IMAGE_PROVIDER_MODEL=gpt-image-2
TUBEFLOW_COVER_IMAGE_PROVIDER_SIZE=2560x1440
TUBEFLOW_COVER_IMAGE_PROVIDER_QUALITY=high
TUBEFLOW_COVER_IMAGE_PROVIDER_TIMEOUT_SECONDS=180
# ElevenLabs 付费配音（境外服务，克隆音色 + TTS；API key 走数据库号池管理页，不经 env）
TUBEFLOW_ELEVENLABS_API_BASE=https://api.elevenlabs.io
# EL 流量代理：compose 内默认指向 mihomo 容器；仅 ElevenLabs 请求走该代理，其余线路不受影响。置空字符串 = 直连（仅限部署机自带境外网络时）
TUBEFLOW_ELEVENLABS_PROXY=http://mihomo:7890
TUBEFLOW_ELEVENLABS_TTS_MODEL=eleven_v4
# voice_settings（三项全空 = 不发送该字段，EL 按音色存储默认值合成）；「创造力」= stability、「相似度」= similarity_boost
TUBEFLOW_ELEVENLABS_STABILITY=1
TUBEFLOW_ELEVENLABS_SIMILARITY_BOOST=1
TUBEFLOW_ELEVENLABS_USE_SPEAKER_BOOST=true
# 每个 key 的并发上限（按进程生效，web 与 worker 各自实例化会叠加；多 worker 部署须相应调低）
TUBEFLOW_ELEVENLABS_PER_KEY_CONCURRENCY=4
# 单句实测时长护栏（秒）：超限判异常并重发一次，仍超落失败
TUBEFLOW_ELEVENLABS_DURATION_GUARD_SECONDS=60
# mihomo 代理容器：机场订阅链接（clash/mihomo YAML 格式，属凭证，只写 .env，不入库不进 git）
MIHOMO_SUBSCRIPTION_URL=
# mihomo 节点锁定过滤（按节点名匹配的正则，默认锁定新加坡节点；无匹配时保持订阅默认节点）
MIHOMO_NODE_FILTER=新加坡|Singapore|🇸🇬|SG
